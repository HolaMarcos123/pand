# ═══════════════════════════════════════════════════════════════
#  Copiá esto a .env.local y completalo. .env.local es DESARROLLO.
#
#  Producción NO vive acá: vive en Vercel (Settings → Environment Variables).
#  Apuntar .env.local a producción significa que `npm run dev` escribe en la
#  cartera de un cliente real, y una prueba de importación le mete miles de
#  cuotas que nadie pidió.
#
#  Para una migración contra producción a mano está .env.production.local,
#  que solo se lee cuando se pide:  $env:PAND_DB='prod'; npx prisma migrate deploy
#  Lo normal es no usarlo: el build de Vercel ya corre las migraciones.
# ═══════════════════════════════════════════════════════════════

# ─── Supabase (el proyecto de desarrollo, NO el de producción) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreto. Dashboard → Project Settings → API Keys → service_role → Reveal.
# Solo lo usan invitar y borrar usuarios: sin él, el resto anda igual.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Base de datos (Prisma) ──────────────────────────────────
# Pooler transaccion (6543) para runtime; pooler sesion (5432) para migraciones.
DATABASE_URL=
DIRECT_URL=

# ─── Base de datos de pruebas ────────────────────────────────
# Puede ser el mismo proyecto que desarrollo: cada test de base se crea su
# propia organización y la borra, así que no pisa lo que estés probando.
# Existe aparte para que, si dev vuelve a apuntar a otro lado, los tests no se
# vayan con él. Si falta, los tests corren contra DATABASE_URL y lo avisan.
TEST_DATABASE_URL=

# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Redis (BullMQ) ──────────────────────────────────────────
REDIS_URL=

# ─── Resend ──────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Backoffice de Pand ──────────────────────────────────────
# Emails separados por coma que pueden entrar a /backoffice y ver TODAS las
# empresas clientes. Vacío = nadie.
PLATFORM_ADMIN_EMAILS=

# ─── App ─────────────────────────────────────────────────────
# Alta pública. Default CERRADO: si no dice exactamente "true", no se puede
# crear una organización nueva. Un olvido deja el registro cerrado, nunca abierto.
REGISTRATION_OPEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
