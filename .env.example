# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Base de datos (Prisma) ──────────────────────────────────
# Pooler transaccion (6543) para runtime; pooler sesion (5432) para migraciones.
DATABASE_URL=
DIRECT_URL=

# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Base de datos de pruebas ────────────────────────────────
# Proyecto "Pand Test" · ref nqujmhielcdovwcpiusd · sa-east-1
# Solo la usa `npm run test:db`. Si falta, los tests corren contra DATABASE_URL
# y lo avisan: preferible eso a no correrlos, pero mejor apuntarlos acá.
# Pooler en modo sesion (5432), igual que DIRECT_URL.
TEST_DATABASE_URL=

# ─── Redis (BullMQ) ──────────────────────────────────────────
REDIS_URL=

# ─── Resend ──────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Backoffice de Pand ──────────────────────────────────────
# Emails separados por coma que pueden entrar a /backoffice y ver TODAS las
# empresas clientes. Es el permiso mas alto del producto y por eso vive aca y no
# en la base: escalarlo exige desplegar, no escribir una fila.
# Vacio = nadie entra. El default es cerrado a proposito.
PLATFORM_ADMIN_EMAILS=

# ─── App ─────────────────────────────────────────────────────
# Alta publica. Default CERRADO: si no dice exactamente "true", no se puede
# crear una organizacion nueva. Un olvido deja el registro cerrado, nunca abierto.
REGISTRATION_OPEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
